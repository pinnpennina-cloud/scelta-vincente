---
const base = import.meta.env.BASE_URL;

const navLinks = [
  { href: `${base}chi-siamo`, label: 'Chi siamo' },
  { href: `${base}#attivita`, label: 'Attività' },
  { href: `${base}news`, label: 'News' },
  { href: `${base}contatti`, label: 'Contatti' },
];
---
<header class="site-header">
  <nav class="nav">
    <a href={base} class="logo">
      <span class="logo-mark"></span>Scelta Vincente
    </a>
    <div class="nav-links" id="nav-links">
      <ul>
        {navLinks.map((link) => (
          <li><a href={link.href}>{link.label}</a></li>
        ))}
      </ul>
    </div>
    <a href={`${base}#supporta`} class="nav-cta">Dona ora</a>
    <button class="menu-toggle" aria-label="Apri menu" id="menu-toggle">☰</button>
  </nav>
</header>

<script>
  const toggle = document.getElementById('menu-toggle');
  const links = document.getElementById('nav-links');

  toggle?.addEventListener('click', () => {
    links?.classList.toggle('is-open');
  });
</script>
